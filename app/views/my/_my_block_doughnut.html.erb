<div class="indicator-card">
  <div class="indicator-card-header">
    <h3><%= link_to query.name, _project_issues_path(query.project, query.as_params) %></h3>
  </div>
  <div class="indicator-chart-wrapper" style="position: relative;">
    <canvas id="<%= id %>" class="doughnut"></canvas>
    <div id="<%= id %>-center" class="doughnut-center-metric" style="display: none;">
      <span class="metric-total">0</span>
      <span class="metric-caption"><%= l(:label_issue_plural) %></span>
    </div>
  </div>
</div>
<script>
(function() {
  var enterpriseColors = [
    '#3b82f6', '#10b981', '#8b5cf6', '#f59e0b', '#ec4899',
    '#06b6d4', '#6366f1', '#14b8a6', '#f97316', '#84cc16',
    '#64748b', '#a855f7', '#0284c7', '#059669', '#d97706'
  ];
  var canvas = document.getElementById('<%= id %>');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var labels = <%= raw labels %>;
  var datas = <%= datas %>;
  var total = 0;
  for (var k = 0; k < datas.length; ++k) {
    total += Number(datas[k]) || 0;
  }

  var centerMetric = document.getElementById('<%= id %>-center');
  if (centerMetric) {
    var totalSpan = centerMetric.querySelector('.metric-total');
    if (totalSpan) totalSpan.textContent = total;
    centerMetric.style.display = 'flex';
  }

  // Handle empty state
  if (total === 0) {
    labels = ['<%= l(:label_no_data) %>'];
    datas = [1];
    var bgColors = ['#e2e8f0'];
  } else {
    var bgColors = [];
    for (var i = 0; i < labels.length; ++i) {
      bgColors.push(enterpriseColors[i % enterpriseColors.length]);
    }
  }

  new Chart(ctx, {
    type: 'doughnut',
    data: {
      labels: labels,
      datasets: [{
        data: datas,
        backgroundColor: bgColors,
        borderWidth: 2,
        borderColor: '#ffffff'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: true,
      cutoutPercentage: 70,
      legend: {
        position: 'right',
        labels: {
          boxWidth: 12,
          fontSize: 12,
          padding: 10,
          fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif'
        }
      },
      tooltips: {
        enabled: total > 0,
        backgroundColor: 'rgba(15, 23, 42, 0.92)',
        titleFontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
        bodyFontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
        cornerRadius: 8,
        xPadding: 12,
        yPadding: 10,
        callbacks: {
          label: function(tooltipItem, data) {
            var val = data.datasets[0].data[tooltipItem.index];
            var pct = total > 0 ? ((val * 100) / total).toFixed(1) : 0;
            return ' ' + data.labels[tooltipItem.index] + ': ' + val + ' (' + pct + '%)';
          }
        }
      },
      animation: {
        animateScale: true,
        animateRotate: true
      }
    }
  });
})();
</script>
