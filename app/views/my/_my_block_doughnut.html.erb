<div class="indicator-card">
  <h3><%= link_to query.name, _project_issues_path(query.project, query.as_params) %></h3>
  <canvas id="<%= id %>" class="doughnut"></canvas>
</div>
<script>
(function() {
  var enterpriseColors = [
    '#3b82f6', '#10b981', '#8b5cf6', '#f59e0b', '#ec4899',
    '#06b6d4', '#6366f1', '#14b8a6', '#f97316', '#84cc16',
    '#64748b', '#a855f7', '#0284c7', '#059669', '#d97706'
  ];
  var canvas = document.getElementById('<%= id %>');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var labels = <%= raw labels %>;
  var datas = <%= datas %>;
  var bgColors = [];

  for (var i = 0; i < labels.length; ++i) {
    bgColors.push(enterpriseColors[i % enterpriseColors.length]);
  }

  new Chart(ctx, {
    type: 'doughnut',
    data: {
      labels: labels,
      datasets: [{
        data: datas,
        backgroundColor: bgColors,
        borderWidth: 2,
        borderColor: '#ffffff'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: true,
      legend: {
        position: 'right',
        labels: {
          boxWidth: 14,
          fontSize: 12,
          padding: 12,
          fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif'
        }
      },
      cutoutPercentage: 62,
      animation: {
        animateScale: true,
        animateRotate: true
      }
    }
  });
})();
</script>
